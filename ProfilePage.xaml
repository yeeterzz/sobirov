<Page x:Class="auth.pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:auth.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfilePage">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="🦸‍♂️" FontSize="90" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,40,0,0"/>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,50,20,20">

            <TextBlock Text="Иванов Иван Иванович" FontSize="26" FontWeight="Bold" Foreground="Black" Margin="0,0,0,8"/>

            <TextBlock Text="Факультет информационных технологий" FontSize="14" Foreground="Gray" Margin="0,0,0,4"/>

            <TextBlock Text="4-й курс, группа ИС 231-4" FontSize="14" Foreground="Gray" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Email: " FontSize="13" FontWeight="Bold" Foreground="DarkSlateGray"/>
                <TextBlock Text="ivanov.i@university.edu" FontSize="13" Foreground="SlateGray"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Телефон: " FontSize="13" FontWeight="Bold" Foreground="DarkSlateGray"/>
                <TextBlock Text="+7 (912) 345-67-89" FontSize="13" Foreground="SlateGray"/>
            </StackPanel>
        </StackPanel>
        </Grid>
</Page>
