<Page x:Class="auth.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:auth"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPage">

    <Grid>
        <Grid Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Background="LightGray">
                <TextBlock Text="Меню" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <Button Name="ProfileButton" Content="Профиль" Click="ProfileButton_Click" Margin="5,15,5,0" Height="35"/>
                <Button Name="CatalogButton" Content="Каталог" Margin="5,10,5,0" Click="CatalogButton_Click" Height="35"/>
                <Button Name="CartButton" Content="Корзина" Margin="5,10,5,0" Click="CartButton_Click" Height="35"/>
                <Button Name="BackButton" Content="Назад" Margin="5,10,5,0" Click="BackButton_Click" Height="35"/>
            </StackPanel>

            <Frame Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Source="ProfilePage.xaml"/>
        </Grid>
    </Grid>
</Page>
